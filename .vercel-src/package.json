{
  "name": "socialpay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test tests/unit",
    "lint": "oxlint --type-aware src app lib scripts 2>&1 | head -n 100",
    "lint:check": "oxlint --type-aware src app lib scripts 2>&1 | head -n 100",
    "check": "bash scripts/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "hardhat:compile": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' hardhat compile",
    "hardhat:test": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' hardhat test",
    "deploy:create2factory": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' hardhat run scripts/deploy-create2factory.ts --network arc",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "db:health": "curl -s http://localhost:3000/api/health | head -c 2000"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.19.3",
    "@circle-fin/app-kit": "^1.19.0",
