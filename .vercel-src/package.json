    "@solana/kit": "^8.0.0",
    "@tanstack/react-query": "^5.62.7",
    "@web3icons/react": "^4.0.0",
    "@x402/core": "^2.0.0",
    "@x402/evm": "^2.0.0",
    "@x402/extensions": "^2.0.0",
    "@x402/svm": "^2.0.0",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
