# --- Hardhat / Arc Testnet deployment (see hardhat.config.ts) ---
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
# 0x-prefixed hex private key of the deployer. NEVER commit a real key.
DEPLOYER_PRIVATE_KEY=0x

# --- Create2Factory flow ---
# Filled after: npx hardhat run scripts/deploy-create2factory.ts --network arcTestnet
FACTORY_ADDRESS=
# Forge script inputs (see contracts/script/DeployCreate2.s.sol).
# CREATE2_SALT is the *user* salt; the script namespaces it with the broadcaster.
CREATE2_SALT=
CREATION_CODE=
DEPLOY_VALUE=0
# Chain-id guard for DeployCreate2 (default 5042002 = Arc Testnet; use 31337 for local rehearsal).
EXPECTED_CHAIN_ID=5042002
