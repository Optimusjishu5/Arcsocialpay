# --- Hardhat / Arc Mainnet deployment (see hardhat.config.ts) ---
# Network: Arc Mainnet | Chain ID: 5042 | RPC: https://rpc.mainnet.arc.io
# Explorer: https://explorer.arc.io | Gas token: USDC
ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
# Legacy alias — hardhat.config.ts also reads ARC_TESTNET_RPC as a fallback.
ARC_TESTNET_RPC=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_RPC=https://rpc.mainnet.arc.io
# ArcSocialPay contract (Remix deployment). Empty until you paste the address.
NEXT_PUBLIC_SOCIAL_PAY_ADDRESS=
# 0x-prefixed hex private key of the deployer. NEVER commit a real key.
DEPLOYER_PRIVATE_KEY=0x

# --- Turso (LibSQL) persistent chat storage ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Create2Factory flow ---
# Filled after: npx hardhat run scripts/deploy-create2factory.ts --network arc
FACTORY_ADDRESS=
# Forge script inputs (see contracts/script/DeployCreate2.s.sol).
# CREATE2_SALT is the *user* salt; the script namespaces it with the broadcaster.
CREATE2_SALT=
CREATION_CODE=
DEPLOY_VALUE=0
# Chain-id guard for DeployCreate2 (default 5042 = Arc Mainnet; use 31337 for local rehearsal).
EXPECTED_CHAIN_ID=5042
